# Copy this file to .env and fill in the values.
# Supabase dashboard -> your project -> "Connect" button / Project Settings -> API Keys

PORT=4000
# The React app (Vite) address, allowed by CORS. Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173

# Postgres connection string. Dashboard -> Connect -> "Session pooler" (works on IPv4).
# Local Supabase (supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Project URL and keys. Local: http://127.0.0.1:54321 and the keys printed by `supabase start`.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable / anon key (used for sign-up and sign-in calls)
SUPABASE_ANON_KEY=
# Secret / service_role key: SERVER ONLY, never put this in the React app
SUPABASE_SERVICE_ROLE_KEY=

# Sanadak assistant: the Conversational Agents (Dialogflow CX) agent in Google Cloud.
# The defaults in src/config/env.ts already point at our agent, so these are optional.
# Sign in once on this computer with:  gcloud auth application-default login
# GCP_PROJECT_ID=midyear-diorama-514913-a7
# GCP_LOCATION=global
# GCP_AGENT_ID=af82b14f-132c-45e3-801b-a8f5ad6b18ce
# GCP_PLAYBOOK_ID=00000000-0000-0000-0000-000000000000
# GCP_LANGUAGE=en
